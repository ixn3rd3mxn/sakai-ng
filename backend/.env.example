MONGO_URI=
DB_NAME=
CORS_ORIGINS=

# NIEMS RNIS call-centre stats feed (all optional - defaults match Pattani/94).
# The day range is always derived server-side as a Bangkok calendar day.
CALL_STATS_URL=
CALL_STATS_BRANCH_ID=
CALL_STATS_ORG_CODE=
# Seconds a successful response is reused before re-fetching upstream.
CALL_STATS_POLL_SECONDS=

# Live feed used for today's incoming/answer/sla only. It has no
# queue_full_abandon and serves today only, so abandon/queue_full_abandon/
# outgoing, all history, and the day-over-day comparison still come from
# CALL_STATS_URL above.
CALL_STATS_LIVE_URL=

# Duration statistics (avg/longest accept, avg/total service) for the second
# row of cards. Same rollup family and parameters as CALL_STATS_URL.
CALL_STATS_TIMES_URL=

# The 24 hourly buckets behind the by-hour chart. Same parameters as
# CALL_STATS_URL.
CALL_STATS_HOURLY_URL=

# Live agent roster behind the agent-status board.
CALL_STATS_AGENTS_URL=

# The two per-call log tables: abandoned callers (today only, grouped by
# number) and the per-call log (paged, epoch range).
CALL_LOG_ABANDON_URL=
CALL_LOG_URL=

# Thai-IP relay in front of the NIEMS APIs (relay/relay.php). Leave both
# blank - the default - and every feed above is fetched directly, which is
# what you want on a machine in Thailand or if this backend ever moves onto
# Thai hosting. Set both and the same requests go through the relay instead,
# unchanged in every other way.
#
# It is needed because rnis-iqm-ptn.niems.go.th accepts Thai addresses only:
# measured, a Thai ISP and a Thai datacentre both get HTTP 200 while AWS
# Virginia and Singapore get a connect timeout - the packets are dropped, not
# refused - so a foreign-hosted backend cannot reach it at all.
#
# NIEMS_RELAY_TOKEN must match RELAY_TOKEN on the relay host. Half a
# configuration counts as "off", so a URL without a token still goes direct.
NIEMS_RELAY_URL=
NIEMS_RELAY_TOKEN=
