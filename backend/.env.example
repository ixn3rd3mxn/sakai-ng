MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
DB_NAME=ems_dashboard
# Comma-separated extra origins allowed to call the API (e.g. your Vercel URL)
CORS_ORIGINS=https://your-app.vercel.app

# NIEMS RNIS call-centre stats feed (all optional - defaults match Pattani/94).
# The day range is always derived server-side as a Bangkok calendar day.
CALL_STATS_URL=https://rnis-iqm-ptn.niems.go.th/v2/stats/summary/summaries
CALL_STATS_BRANCH_ID=94
CALL_STATS_ORG_CODE=94
# Seconds a successful response is reused before re-fetching upstream.
CALL_STATS_POLL_SECONDS=60

# Live feed used for today's incoming/answer/sla only. It has no
# queue_full_abandon and serves today only, so abandon/queue_full_abandon/
# outgoing, all history, and the day-over-day comparison still come from
# CALL_STATS_URL above.
CALL_STATS_LIVE_URL=https://rnis-iqm-ptn.niems.go.th/v2/summary/today

# Duration statistics (avg/longest accept, avg/total service) for the second
# row of cards. Same rollup family and parameters as CALL_STATS_URL.
CALL_STATS_TIMES_URL=https://rnis-iqm-ptn.niems.go.th/v2/stats/summary/times

# The 24 hourly buckets behind the by-hour chart. Same parameters as
# CALL_STATS_URL.
CALL_STATS_HOURLY_URL=https://rnis-iqm-ptn.niems.go.th/v2/stats/hourly/summaries

# Live agent roster behind the agent-status board.
CALL_STATS_AGENTS_URL=https://rnis-iqm-ptn.niems.go.th/v2/agent

# The two per-call log tables: abandoned callers (today only, grouped by
# number) and the per-call log (paged, epoch range).
CALL_LOG_ABANDON_URL=https://rnis-iqm-ptn.niems.go.th/v2/abandon/today
CALL_LOG_URL=https://rnis-iqm-ptn.niems.go.th/v2/call-logs
