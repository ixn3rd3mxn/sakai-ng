MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
DB_NAME=ems_dashboard
# Comma-separated extra origins allowed to call the API (e.g. your Vercel URL)
CORS_ORIGINS=https://your-app.vercel.app

# NIEMS RNIS call-centre stats feed (all optional - defaults match Pattani/94).
# The day range is always derived server-side as a Bangkok calendar day.
CALL_STATS_URL=https://rnis-api-qm.niems.go.th/v2/stats/summary/summaries
CALL_STATS_BRANCH_ID=94
CALL_STATS_ORG_CODE=94
# Seconds a successful response is reused before re-fetching upstream.
CALL_STATS_POLL_SECONDS=60

# Live feed used for today's incoming/answer/sla only ({branch} is substituted
# with CALL_STATS_BRANCH_ID). It has no queue_full_abandon and serves today
# only, so abandon/queue_full_abandon/outgoing, all history, and the
# day-over-day comparison still come from CALL_STATS_URL above.
CALL_STATS_LIVE_URL=https://rnis-api-sse-dashboard.niems.go.th/v1/{branch}/summary/today
